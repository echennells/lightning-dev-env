{
  "comment": "Version matrix for testing Lightning dev environment",
  "version_sets": [
    {
      "name": "stable",
      "description": "Current stable releases",
      "versions": {
        "bitcoin_core": "30.2",
        "litd": "v0.16.1-alpha",
        "lnd": "v0.20.1-beta",
        "lnbits": "v1.5.3",
        "lnurlp_ext": "1.3.0",
        "withdraw_ext": "1.2.2",
        "lnurlflip_ext": "main",
        "taproot_assets_ext": "main",
        "bitcoinswitch_ext": "main",
        "laisee_ext": "v0.7"
      },
      "build_from_source": {
        "lnd": {
          "repo": "https://github.com/lightningnetwork/lnd.git",
          "branch": "v0.20.1-beta",
          "dockerfile": "Dockerfile",
          "build_args": {
            "checkout": "v0.20.1-beta"
          }
        }
      }
    },
    {
      "name": "bleeding-edge",
      "description": "Latest litd + LNbits dev branch (catch LNbits breakages early)",
      "versions": {
        "bitcoin_core": "30.0",
        "litd": "v0.16.0-alpha",
        "lnd": "0.18.4-beta",
        "lnbits": "dev",
        "lnurlp_ext": "1.2.0",
        "withdraw_ext": "1.2.2",
        "lnurlflip_ext": "main",
        "taproot_assets_ext": "main",
        "bitcoinswitch_ext": "main",
        "laisee_ext": "v0.7"
      },
      "build_from_source": {
        "lnbits": {
          "repo": "https://github.com/lnbits/lnbits.git",
          "branch": "dev",
          "dockerfile": "Dockerfile"
        }
      }
    },
    {
      "name": "legacy",
      "description": "One major release back",
      "versions": {
        "bitcoin_core": "30.0",
        "litd": "v0.15.2-alpha",
        "lnd": "0.18.4-beta",
        "lnbits": "v1.3.0",
        "lnurlp_ext": "1.1.2",
        "withdraw_ext": "1.0.1",
        "lnurlflip_ext": "main",
        "taproot_assets_ext": "main",
        "bitcoinswitch_ext": "main",
        "laisee_ext": "v0.7"
      }
    }
  ],
  "docker_images": {
    "bitcoin_core": "boltz/bitcoin-core:{version}",
    "litd": "lightninglabs/lightning-terminal:{version}",
    "lnd": "boltz/lnd:{version}",
    "lnbits": "lnbits/lnbits:{version}"
  },
  "extension_repos": {
    "lnurlp": {
      "repo": "https://github.com/lnbits/lnurlp",
      "version_type": "tag"
    },
    "withdraw": {
      "repo": "https://github.com/lnbits/withdraw",
      "version_type": "tag"
    },
    "lnurlflip": {
      "repo": "https://github.com/echennells/lnurlFlip",
      "version_type": "branch"
    },
    "taproot_assets": {
      "repo": "https://github.com/echennells/taproot_assets",
      "version_type": "tag"
    },
    "bitcoinswitch": {
      "repo": "https://github.com/echennells/bitcoinswitch",
      "version_type": "branch"
    },
    "laisee": {
      "repo": "https://github.com/Liongrass/laisee_extension",
      "version_type": "tag",
      "install_as": "laisee"
    }
  }
}
